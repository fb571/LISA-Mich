# ============================================================

@nb.njit(fastmath=True)
def gw_time_domain_inplace(out, t, A, f0, e,J_slice, I, phi, n_vals):
    Nt = t.size
    nmax = n_vals.size

    omega = 2 * np.pi * f0
    pref = -A

    CI = np.cos(I)
    Cphi = np.cos(phi)
    C2phi = np.cos(2*phi)
    Sphi = np.sin(phi)
    S2phi = np.sin(2*phi)

    for i in range(Nt):
        ti = t[i]
        hp = 0.0
        hc = 0.0

        for j in range(nmax):
            nj = n_vals[j]

            Jm2 = J_slice[j, 0]
            Jm1 = J_slice[j, 1]
            Jp1 = J_slice[j, 2]
            Jp2 = J_slice[j, 3]

            nAn = nj * (Jm2 - Jp2 - 2.0 * e * (Jm1 - Jp1))
            nBn = nj * (1.0 - e*e) * (Jp2 - Jm2)
            nCn = nj * np.sqrt(1.0 - e*e) * (Jp2 + Jm2 - e * (Jp1 + Jm1))

            phase = omega * nj * ti

            hp += (
                (nAn * (Cphi*Cphi - Sphi*Sphi*CI*CI)
               + nBn * (Sphi*Sphi - Cphi*Cphi*CI*CI)) * np.cos(phase)
               - nCn * np.sin(2*phi) * (1 + CI*CI) * np.sin(phase)
            )

            hc += (
                (2 * np.sin(phase)) * C2phi * CI * nCn
                + (nAn - nBn) * np.cos(phase) * S2phi * CI
            )

        out[i] = pref * (hp + 1j * hc)

@nb.njit(cache=True)
def jit_rfft(x):
    return np.fft.rfft(x)


