from fastlisaresponse.utils.parallelbase import ParallelModuleBase

# Parallel module base can help to facilitate customized gpu use.
class GBWave(ParallelModuleBase):
    def __init__(self, force_backend=None):
        super().__init__(force_backend=force_backend)

    @classmethod
    def supported_backends(cls):
        return ["fastlisaresponse_" + _tmp for _tmp in cls.GPU_RECOMMENDED()]

    def __call__(self, A, f0, e, I, phi, T=1.0, dt=10.0):
        n_vals = np.arange(1,11)

        # get the t array
        t = self.xp.arange(0.0, T * YRSID_SI, dt)

        h_td_buffer = np.empty(len(t), dtype=np.complex128)
        e_idx = np.argmin(np.abs(e_grid - e))
        J_slice = get_J_slice_interp(e)
        
        gw_time_domain_inplace(
        h_td_buffer,
        t,
        A,
        f0,
        e,
        J_slice,
        I,
        phi,
        n_vals,
        )

        return h_td_buffer  # Return the buffer that was modified in-place

